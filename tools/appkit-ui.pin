# The one place that names the version of appkit-ui (https://github.com/StefanBartl/appkit, folder ui-kit) this
# window takes its design tokens from: the same tag as tasks-desktop and rules-desktop, so the three look alike.
#
# src/appkit-tokens.css is ui-kit/src/tokens.css at this tag, byte for byte, and src/appkit-tokens-fallback.css is
# generated from it. tools/check-appkit-tokens.py checks both, and that the tag still names this commit (a moved
# tag would change the file under the same name). To move to another tag: change both lines, then
#
#     python tools/check-appkit-tokens.py --write
#
# and look at the window in both themes.
tag = v0.4.2
commit = 2f053e6164d1171ecb8db0a1ee4da544c00b2654
