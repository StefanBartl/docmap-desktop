{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "docmap-desktop",
  "version": "0.3.0",
  "identifier": "dev.stefanbartl.docmap-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "docmap — know your project",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
